# Enforce Unix-style line endings
* text=auto eol=lf

# Deny checkout of files with mixed line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.patch text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Preserve verbatim upstream license evidence, including original whitespace.
resources/third-party-licenses/runtime/LICENSE* -text -whitespace
resources/third-party-licenses/workflows/LICENSE* -text -whitespace
resources/third-party-licenses/workflows/NOTICE -text -whitespace
resources/third-party-licenses/THIRD-PARTY-NOTICES.txt -whitespace
